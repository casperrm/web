# Cedar Point Media intake — server-side configuration.
# None of these values are ever sent to the browser.

# Resend (https://resend.com) API key used to deliver submissions.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend. Until a domain is
# verified, Resend only allows onboarding@resend.dev, and only to the email
# address that owns the Resend account.
MAIL_FROM="Cedar Point Media <onboarding@resend.dev>"

# Where every submission is delivered.
MAIL_TO=consultingcedarpoint@gmail.com

# Optional: Cloudflare Turnstile CAPTCHA. Set BOTH to enable it.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Set to 1 when running behind a reverse proxy/load balancer (Render, Fly,
# Nginx...) so rate limiting uses the real client IP from X-Forwarded-For.
TRUST_PROXY=1

# Max submissions per IP per hour (default 5).
# RATE_LIMIT_PER_HOUR=5

# Local testing: print the email to the console instead of sending it.
# MAIL_DRY_RUN=1

PORT=3000
